TARGET := 00_CORTEX_12_PRINTF_f103
BUILD_DIR := build/firmware

PREFIX ?= arm-none-eabi-
CC := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
SIZE := $(PREFIX)size

CPU_FLAGS := -mcpu=cortex-m3 -mthumb -mfloat-abi=soft
DEFINES := -DUSE_HAL_DRIVER -DSTM32F103xB
INCLUDES := \
	-ICore/Inc \
	-IDrivers/STM32F1xx_HAL_Driver/Inc \
	-IDrivers/STM32F1xx_HAL_Driver/Inc/Legacy \
	-IDrivers/CMSIS/Device/ST/STM32F1xx/Include \
	-IDrivers/CMSIS/Include

CFLAGS := $(CPU_FLAGS) -std=gnu11 -Og -g3 $(DEFINES) $(INCLUDES) \
	-Wall -Wextra -ffunction-sections -fdata-sections
ASFLAGS := $(CPU_FLAGS) -x assembler-with-cpp $(DEFINES) $(INCLUDES)
LDFLAGS := $(CPU_FLAGS) -TSTM32F103RBTX_FLASH.ld --specs=nosys.specs \
	--specs=nano.specs -Wl,-Map=$(BUILD_DIR)/$(TARGET).map \
	-Wl,--gc-sections -static -Wl,--start-group -lc -lm -Wl,--end-group

C_SOURCES := $(wildcard Core/Src/*.c) \
	$(wildcard Drivers/STM32F1xx_HAL_Driver/Src/*.c)
ASM_SOURCES := Core/Startup/startup_stm32f103rbtx.s
C_OBJECTS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(C_SOURCES))
ASM_OBJECTS := $(patsubst %.s,$(BUILD_DIR)/%.o,$(ASM_SOURCES))
OBJECTS := $(C_OBJECTS) $(ASM_OBJECTS)
DEPS := $(C_OBJECTS:.o=.d)

ELF := $(BUILD_DIR)/$(TARGET).elf
HEX := $(BUILD_DIR)/$(TARGET).hex
BIN := $(BUILD_DIR)/$(TARGET).bin

ifeq ($(OS),Windows_NT)
SHELL := cmd.exe
.SHELLFLAGS := /C
define make-dir
	@if not exist "$(subst /,\,$(1))" mkdir "$(subst /,\,$(1))"
endef
define remove-dir
	@if exist "$(subst /,\,$(1))" rmdir /S /Q "$(subst /,\,$(1))"
endef
else
define make-dir
	@mkdir -p $(1)
endef
define remove-dir
	$(RM) -r $(1)
endef
endif

.PHONY: all clean

all: $(ELF) $(HEX) $(BIN)
	$(SIZE) $(ELF)

$(ELF): $(OBJECTS) STM32F103RBTX_FLASH.ld
	$(call make-dir,$(@D))
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@

$(HEX): $(ELF)
	$(OBJCOPY) -O ihex $< $@

$(BIN): $(ELF)
	$(OBJCOPY) -O binary $< $@

$(BUILD_DIR)/%.o: %.c
	$(call make-dir,$(@D))
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD_DIR)/%.o: %.s
	$(call make-dir,$(@D))
	$(CC) $(ASFLAGS) -c $< -o $@

clean:
	$(call remove-dir,$(BUILD_DIR))

-include $(DEPS)
